# Publish only the reviewed distribution. Local research stays in this workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/VERSION
!/public-files.json
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/academic-deai-zh/
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/workflows/release.yml
!/docs/
!/examples/
!/tools/
!/tests/
/tests/*
!/tests/test_deai_core.py
!/tests/test_v12_scope.py
!/tests/test_v13_workflow.py
!/tests/test_v14_workflow.py
!/tests/test_runtime_workflow.py
!/tests/test_oss_release.py
**/__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.zip
dist/
.venv/
